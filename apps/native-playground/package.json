{
  "name": "@vellira-ui/native-playground",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "build:web": "expo export --platform web --output-dir dist-web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@expo/metro-runtime": "~57.0.7",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@vellira-ui/assets": "workspace:*",
    "@vellira-ui/icons": "workspace:*",
    "@vellira-ui/react-native": "workspace:*",
    "babel-loader": "^10.1.1",
    "expo": "~57.0.7",
    "expo-font": "^57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-reanimated": "~4.5.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.3",
    "typescript": "6.0.3"
  }
