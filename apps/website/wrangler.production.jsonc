{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vellira-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CF_WORKER_NAME": "vellira-website",
    "CF_PREVIEW_DOMAIN": "vellira"
  },
  "secrets": {
    "required": [
      "CF_ACCOUNT_ID",
      "CF_WORKERS_SCRIPTS_API_TOKEN"
    ]
  },
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "images": {
    "binding": "IMAGES"
  }
}
