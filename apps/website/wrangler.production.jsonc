{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vellira-website",
  "main": "./cloudflare-worker.mjs",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/__vellira_runtime"],
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "observability": {
    "enabled": true,
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "r2_buckets": [
    {
      "binding": "STATIC_ASSET_ARCHIVE",
      "bucket_name": "vellira-website-static-archive",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
}
