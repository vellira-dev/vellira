{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vellira-website",
  "main": "./cloudflare-worker.mjs",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "images": {
    "binding": "IMAGES"
  }
}
