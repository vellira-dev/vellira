# Current content-hashed assets stay on the Workers Assets fast path.
# Old immutable URLs use the same policy in the Worker archive fallback.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned, reviewed social media; v1 bytes are immutable after admission.
/media/component-demos/v1/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
