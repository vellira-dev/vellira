{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": [
      "vellira-source"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "expo-blur": [
        "./src/sections/home/ProductInterfaceDemo/native-web-adapters/ExpoBlur.tsx"
      ],
      "react-native-safe-area-context": [
        "./src/sections/home/ProductInterfaceDemo/native-web-adapters/SafeArea.tsx"
      ],
      "@react-native-async-storage/async-storage": [
        "./src/sections/home/ProductInterfaceDemo/native-web-adapters/AsyncStorage.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
