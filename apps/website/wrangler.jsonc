{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vellira-website-staging",
  "main": "./cloudflare-worker.mjs",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": ["BUTTONDOWN_API_KEY"],
  },
  "vars": {
    "NEWSLETTER_ABUSE_GUARD_ENABLED": "0",
  },
  "ratelimits": [
    {
      "name": "NEWSLETTER_ROUTE_RATE_LIMIT",
      "namespace_id": "1712202601",
      "simple": { "limit": 12, "period": 60 },
    },
    {
      "name": "NEWSLETTER_ACTOR_RATE_LIMIT",
      "namespace_id": "1712202602",
      "simple": { "limit": 4, "period": 60 },
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/__vellira_runtime"],
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "observability": {
    "enabled": true,
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "r2_buckets": [
    {
      "binding": "STATIC_ASSET_ARCHIVE",
      "bucket_name": "vellira-website-staging-static-archive",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
}
