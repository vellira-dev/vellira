{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vellira-website-staging",
  "main": "./cloudflare-worker.mjs",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/_next/image/*",
      "!/brand/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "images": {
    "binding": "IMAGES"
  }
}
