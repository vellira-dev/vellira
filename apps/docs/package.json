{
  "name": "@vellira-ui/docs",
  "private": true,
  "version": "2.18.4",
  "description": "Documentation website for Vellira Design System",
  "author": "Roman Bakurov",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "sync:brand": "pnpm --filter @vellira-ui/assets sync-brand apps/docs/src/public/brand",
    "predev": "pnpm run sync:brand",
    "dev": "vitepress dev src",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "pnpm run sync:brand",
    "build": "vitepress build src",
    "prepreview": "pnpm run sync:brand",
    "preview": "vitepress preview src"
  },
  "devDependencies": {
    "@vellira-ui/assets": "workspace:*",
    "@vellira-ui/metadata": "workspace:*",
    "@vellira-ui/tokens": "workspace:*",
    "vitepress": "^1.6.4"
  }
}
