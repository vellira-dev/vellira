{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "composite": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "e2e/**/*.ts",
    "e2e/**/*.tsx",
    "*.ts",
    "*.tsx",
    "*.mts",
    "*.cts",
    "../../scripts/public-release/client.ts"
  ],
  "exclude": ["node_modules", "dist", "storybook-static"]
}
