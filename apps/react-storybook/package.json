{
  "name": "@vellira-ui/react-storybook",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @vellira-ui/tokens build:tokens",
    "dev": "storybook dev -p 6006",
    "prebuild": "pnpm --filter @vellira-ui/tokens build:tokens",
    "build": "storybook build",
    "build-storybook": "storybook build",
    "typecheck": "tsc -p ../../packages/react/tsconfig.stories.json --noEmit && tsc -p tsconfig.json --noEmit",
    "playwright:install": "playwright install --with-deps chromium",
    "test:e2e": "playwright test --config=playwright.config.ts --grep-invert @visual",
    "test:e2e:visual": "node scripts/assert-canonical-visual-environment.mjs && playwright test --config=playwright.config.ts --grep @visual",
    "test:e2e:all": "node scripts/assert-canonical-visual-environment.mjs && playwright test --config=playwright.config.ts",
    "test": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@vellira-ui/react": "workspace:*",
    "@vellira-ui/tokens": "workspace:*",
    "clsx": "^2.1.1",
    "focus-trap-react": "^12.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/react": "10.5.7",
    "@storybook/react-dom-shim": "10.5.7",
    "@storybook/react-vite": "^10.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@vellira-ui/assets": "workspace:*",
    "@vellira-ui/icons": "workspace:*",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "chromatic": "^18.0.1",
    "eslint-plugin-storybook": "^10.5.0",
    "lottie-web": "^5.13.0",
    "sass": "^1.99.0",
    "storybook": "^10.5.0",
    "typescript": "6.0.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  }
}
