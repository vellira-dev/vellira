{
  "name": "vellira-workspace-native-starter",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "security:certificate-proof": "node scripts/security-certificate-proof.cjs",
    "postinstall": "node scripts/apply-node-forge-patch.cjs && node scripts/security-expo-58-guard.cjs --apply",
    "prestart": "node scripts/apply-node-forge-patch.cjs --verify && node scripts/security-expo-58-guard.cjs --verify",
    "preios": "node scripts/apply-node-forge-patch.cjs --verify && node scripts/security-expo-58-guard.cjs --verify",
    "preandroid": "node scripts/apply-node-forge-patch.cjs --verify && node scripts/security-expo-58-guard.cjs --verify",
    "preweb": "node scripts/apply-node-forge-patch.cjs --verify && node scripts/security-expo-58-guard.cjs --verify",
    "pretypecheck": "node scripts/apply-node-forge-patch.cjs --verify && node scripts/security-expo-58-guard.cjs --verify",
    "security:verify-patch": "node scripts/apply-node-forge-patch.cjs --verify && node scripts/security-expo-58-guard.cjs --verify"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@vellira-ui/react-native": "2.188.12",
    "expo": "^58.0.19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0",
    "@vellira-ui/icons": "2.188.12",
    "expo-blur": "~58.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
