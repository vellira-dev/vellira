+/**
+ * DER-encodes a DigestInfo value from a digest algorithm OID and digest.
+ *
+ * RSASSA-PKCS1-v1_5 verification uses this to require a canonical DigestInfo
+ * encoding. forge's BER parser and asn1.validate() intentionally tolerate
+ * malformed encodings: extra elements in a SEQUENCE, a NULL parameters field
+ * that carries content bytes, and non-minimal long-form length octets all
+ * leave attacker-controlled slack bytes inside a structurally "valid"
+ * DigestInfo, which is exactly what a low-exponent (e.g. e=3) PKCS#1 v1.5
+ * signature forgery needs (CVE-2026-85393). Re-encoding the expected
+ * DigestInfo and comparing bytes rejects every such variant in a single
+ * check.
+ *
+ * @param oid the digest algorithm OID as a dotted string.
+ * @param digest the digest value as a binary-encoded string.
+ * @param includeParameters true to include the empty NULL parameters field
+ *          in the DigestAlgorithmIdentifier, false to omit it.
+ *
+ * @return the DER-encoded DigestInfo as a binary-encoded string.
+ */
+var _encodeDigestInfo = function(oid, digest, includeParameters) {
+  var digestAlgorithm = [asn1.create(
+    asn1.Class.UNIVERSAL, asn1.Type.OID, false,
+    asn1.oidToDer(oid).getBytes())];
+  if(includeParameters) {
+    digestAlgorithm.push(asn1.create(
+      asn1.Class.UNIVERSAL, asn1.Type.NULL, false, ''));
+  }
+  return asn1.toDer(asn1.create(
+    asn1.Class.UNIVERSAL, asn1.Type.SEQUENCE, true, [
+      asn1.create(
+        asn1.Class.UNIVERSAL, asn1.Type.SEQUENCE, true, digestAlgorithm),
+      asn1.create(
+        asn1.Class.UNIVERSAL, asn1.Type.OCTETSTRING, false, digest)
+    ])).getBytes();
+};
