{
  "name": "@vellira-ui/react-native",
  "version": "2.190.6",
  "description": "React Native components for Vellira Design System",
  "keywords": [
    "vellira",
    "react-native",
    "ui",
    "components",
    "design-system",
    "typescript",
    "mobile"
  ],
  "author": "Roman Bakurov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vellira-dev/vellira.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://vellira.dev",
  "bugs": {
    "url": "https://github.com/vellira-dev/vellira/issues"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "vellira-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./accordion": {
      "types": "./dist/components/Accordion/index.d.ts",
      "react-native": "./dist/accordion.js",
      "import": "./dist/accordion.js",
      "default": "./dist/accordion.js"
    },
    "./button": {
      "types": "./dist/primitives/Button/index.d.ts",
      "react-native": "./dist/button.js",
      "import": "./dist/button.js",
      "default": "./dist/button.js"
    },
    "./checkbox": {
      "types": "./dist/primitives/Checkbox/index.d.ts",
      "react-native": "./dist/checkbox.js",
      "import": "./dist/checkbox.js",
      "default": "./dist/checkbox.js"
    },
    "./dropdown": {
      "types": "./dist/components/Dropdown/index.d.ts",
      "react-native": "./dist/dropdown.js",
      "import": "./dist/dropdown.js",
      "default": "./dist/dropdown.js"
    },
    "./form-field": {
      "types": "./dist/patterns/FormField/index.d.ts",
      "react-native": "./dist/form-field.js",
      "import": "./dist/form-field.js",
      "default": "./dist/form-field.js"
    },
    "./input": {
      "types": "./dist/primitives/Input/index.d.ts",
      "react-native": "./dist/input.js",
      "import": "./dist/input.js",
      "default": "./dist/input.js"
    },
    "./modal": {
      "types": "./dist/components/Modal/index.d.ts",
      "react-native": "./dist/modal.js",
      "import": "./dist/modal.js",
      "default": "./dist/modal.js"
    },
    "./popover": {
      "types": "./dist/components/Popover/index.d.ts",
      "react-native": "./dist/popover.js",
      "import": "./dist/popover.js",
      "default": "./dist/popover.js"
    },
    "./portal": {
      "types": "./dist/primitives/Portal/index.d.ts",
      "react-native": "./dist/portal.js",
      "import": "./dist/portal.js",
      "default": "./dist/portal.js"
    },
    "./radio": {
      "types": "./dist/primitives/Radio/index.d.ts",
      "react-native": "./dist/radio.js",
      "import": "./dist/radio.js",
      "default": "./dist/radio.js"
    },
    "./radio-group": {
      "types": "./dist/components/RadioGroup/index.d.ts",
      "react-native": "./dist/radio-group.js",
      "import": "./dist/radio-group.js",
      "default": "./dist/radio-group.js"
    },
    "./select": {
      "types": "./dist/components/Select/index.d.ts",
      "react-native": "./dist/select.js",
      "import": "./dist/select.js",
      "default": "./dist/select.js"
    },
    "./switch": {
      "types": "./dist/primitives/Switch/index.d.ts",
      "react-native": "./dist/switch.js",
      "import": "./dist/switch.js",
      "default": "./dist/switch.js"
    },
    "./tabs": {
      "types": "./dist/components/Tabs/index.d.ts",
      "react-native": "./dist/tabs.js",
      "import": "./dist/tabs.js",
      "default": "./dist/tabs.js"
    },
    "./textarea": {
      "types": "./dist/primitives/Textarea/index.d.ts",
      "react-native": "./dist/textarea.js",
      "import": "./dist/textarea.js",
      "default": "./dist/textarea.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "react-native": "./dist/theme.js",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./tooltip": {
      "types": "./dist/components/Tooltip/index.d.ts",
      "react-native": "./dist/tooltip.js",
      "import": "./dist/tooltip.js",
      "default": "./dist/tooltip.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsdown && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:subpaths:shared-probe": "tsdown --config tsdown.shared-probe.config.ts --out-dir dist/shared-proof",
    "build:subpaths:probe": "node ../../scripts/performance/native-build-subpaths-optin.cjs",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.stories.json --noEmit && tsc -p tsconfig.tooling.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:subpaths:probe": "vitest run --config vitest.subpath-probe.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.86",
    "react-native-svg": ">=13"
  },
  "dependencies": {
    "@vellira-ui/core": "workspace:*",
    "@vellira-ui/icons": "workspace:*",
    "@vellira-ui/tokens": "workspace:*",
    "@vellira-ui/types": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-native": "^10.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.2",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
