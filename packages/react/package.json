{
  "name": "@vellira-ui/react",
  "version": "2.100.0",
  "description": "Web components for Vellira Design System",
  "keywords": [
    "vellira",
    "react",
    "ui",
    "components",
    "design-system",
    "typescript",
    "accessibility"
  ],
  "author": "Roman Bakurov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vellira-dev/vellira.git",
    "directory": "packages/react"
  },
  "homepage": "https://vellira.dev",
  "bugs": {
    "url": "https://github.com/vellira-dev/vellira/issues"
  },
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "vellira-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/styles.css"
  },
  "imports": {
    "#hooks": "./src/hooks/index.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#managers": "./src/managers/index.ts",
    "#managers/*": "./src/managers/*/index.ts",
    "#patterns": "./src/patterns/index.ts",
    "#patterns/*": "./src/patterns/*/index.ts",
    "#primitives": "./src/primitives/index.ts",
    "#primitives/*": "./src/primitives/*/index.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && vite build",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.stories.json --noEmit && tsc -p tsconfig.tooling.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@vellira-ui/core": "workspace:*",
    "@vellira-ui/icons": "workspace:*",
    "@vellira-ui/tokens": "workspace:*",
    "@vellira-ui/types": "workspace:*",
    "clsx": "^2.1.1",
    "focus-trap-react": "^12.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "jsdom": "^28.1.0",
    "lottie-web": "^5.13.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
